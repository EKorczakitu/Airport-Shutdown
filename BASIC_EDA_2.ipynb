    "def noise_corrected_backbone(G, weight='weight', alpha=0.05):\n",
    "    \"\"\"\n",
    "    Implementation of the Noise-Corrected Backbone (Coscia & Neffke, 2017).\n",
    "    Keeps edges stronger than expected given node strengths.\n",
    "    \"\"\"\n",
    "\n",
    "    # Compute node strengths\n",
    "    strength = {n: sum(d.get(weight, 1.0) for _, d in G[n].items()) for n in G}\n",
    "    m = sum(strength.values()) / 2.0\n",
    "\n",
    "    backbone = nx.Graph()\n",
    "\n",
    "    for u, v, data in G.edges(data=True):\n",
    "        w = data.get(weight, 1.0)\n",
    "        expected = (strength[u] * strength[v]) / (2 * m)\n",
    "        # significance test\n",
    "        if w > expected * (1 + alpha):\n",
    "            backbone.add_edge(u, v, weight=w)\n",
    "    return backbone"
   ]
