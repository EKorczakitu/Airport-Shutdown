    "import networkx as nx\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def disparity_filter(G, weight='weight', alpha=0.05):\n",
    "    \"\"\"\n",
    "    Simple implementation of the Disparity Filter backbone extraction\n",
    "    (Serrano et al., 2009).\n",
    "    Keeps only statistically significant edges based on node-level distribution.\n",
    "    \"\"\"\n",
    "    backbone = nx.Graph()\n",
    "    \n",
    "    for u in G.nodes():\n",
    "        k = len(G[u])\n",
    "        if k > 1:  # skip isolated nodes\n",
    "            sum_w = sum(G[u][v].get(weight, 1.0) for v in G[u])\n",
    "            for v in G[u]:\n",
    "                p_ij = G[u][v].get(weight, 1.0) / sum_w\n",
    "                alpha_ij = 1 - (1 - p_ij) ** (k - 1)\n",
    "                if alpha_ij < alpha:\n",
    "                    backbone.add_edge(u, v, **G[u][v])\n",
    "    return backbone\n"
   ]
